# ---- Backend environment variables (copy to .env and fill in real values) ----
# NEVER commit the real .env file. Keep secrets out of the codebase.

# MongoDB credentials (kept out of the connection string so they are not exposed)
DB_USERNAME=your_db_username
DB_PASSWORD=your_db_password

# MongoDB host/cluster info (no credentials here)
DB_HOST=portfolio.gbiris4.mongodb.net
DB_NAME=portfolio
DB_APP_NAME=Portfolio

# Server config
PORT=5000

# Comma-separated list of allowed frontend origins for CORS
CORS_ORIGIN=http://localhost:3000
